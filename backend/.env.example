DATABASE_URL=postgresql://user:password@localhost:5432/poshard
# Required in all environments. Use a strong random value with at least 16 characters.
JWT_SECRET=replace-with-strong-random-secret
# Optional only for local development when you explicitly want the temporary dev fallback.
# ALLOW_INSECURE_DEV_JWT=false
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
PUBLIC_BASE_URL=https://app.gufo.ink

# Password reset mail
# Use either Brevo API or classic SMTP.
BREVO_API_KEY=replace-with-real-brevo-api-key
SMTP_FROM=Gufo ERP <noreply@gufo.ink>

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-real-smtp-user
SMTP_PASS=replace-with-real-smtp-pass
SMTP_SECURE=false
