DATABASE_URL=postgresql://user:password@localhost:5432/poshard
# Required in all environments. Use a strong random value with at least 16 characters.
JWT_SECRET=replace-with-strong-random-secret
# Optional only for local development when you explicitly want the temporary dev fallback.
# ALLOW_INSECURE_DEV_JWT=false
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Optional only when you intentionally want API-hosted browser origins.
# ALLOW_API_ORIGIN=false
NODE_ENV=development
PUBLIC_BASE_URL=https://app.gufo.ink
CONTROL_PANEL_EMAIL=owner@gufo.local
CONTROL_PANEL_PASSWORD=replace-with-strong-control-panel-password

# Demo seed stays disabled by default. Never enable it on a live client environment unless intentional.
ENABLE_DEMO_SEED=false
# Production safeguard. Keep false unless you explicitly want demo data on production.
ALLOW_PRODUCTION_DEMO_SEED=false
# Optional demo seed overrides for safe local/staging usage.
# DEMO_SEED_EMAIL=admin@demo.local
# DEMO_SEED_PASSWORD=replace-or-leave-empty-to-generate
# DEMO_SEED_TENANT_NAME=Demo Tenant
# DEMO_SEED_SUBDOMAIN=demo

# Required in production. Must point to a persistent mounted directory or object-storage sync path.
# Example on Hetzner/Docker: /app/uploads backed by a host volume.
UPLOADS_DIR=/app/uploads
# Recommended in production when worker runs separately and should be health-checked by file freshness.
WORKER_HEARTBEAT_FILE=/app/uploads/ops/worker-heartbeat.json
# Temporary bypass only for local/dev troubleshooting. Never leave enabled for client environments.
# ALLOW_EPHEMERAL_UPLOADS=false

# Password reset mail
# Use either Brevo API or classic SMTP.
BREVO_API_KEY=replace-with-real-brevo-api-key
SMTP_FROM=Gufo ERP <noreply@gufo.ink>

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-real-smtp-user
SMTP_PASS=replace-with-real-smtp-pass
SMTP_SECURE=false
