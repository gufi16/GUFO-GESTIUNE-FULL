    tenant   Tenant   @relation(fields: [tenantId], references: [id])
    company  Company? @relation(fields: [companyId], references: [id])
    location Location @relation(fields: [locationId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  items InventoryDocItem[]

    @@unique([tenantId, companyId, docNo])
    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([locationId])
  @@index([warehouseId])
  @@index([docDate])
  @@index([status])
}

model InventoryDocItem {
  id             String   @id @default(cuid())
  inventoryDocId String
  productId      String
  systemQty      Decimal  @default(0)
  countedQty     Decimal  @default(0)
  differenceQty  Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  inventoryDoc InventoryDoc @relation(fields: [inventoryDocId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([inventoryDocId])
  @@index([productId])
}

model MinutesDoc {
    id         String           @id @default(cuid())
    tenantId   String
    companyId  String?
    locationId String
  warehouseId String?
  docNo      String
  docDate    DateTime
  type       MinutesDocType
  status     MinutesDocStatus @default(DRAFT)
  reasonCode String?
  findingCode String?
