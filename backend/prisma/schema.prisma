generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE
}

enum ProductClass {
  PRODUS_FIN
  MATERIE_PRIMA
  MARFA
  AMBALAJE
  CONSUMABILE
  SEMIFABRICATE
  REZIDUALE
  ALTE_MATERIALE
}

enum ProductionMode {
  AUTO
  MANUAL
}

enum StockMoveType {
  IN
  OUT
  TRANSFER
  ADJUST
}

enum RefType {
  SALE
  PURCHASE
  TRANSFER
  INVENTORY
  CONSUMPTION
  PRODUCTION
  MINUTES
}

enum CurrencyCode {
  RON
  EUR
  USD
  HUF
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PaymentType {
  CASH
  CARD
  MIXED
}

enum InventoryStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum MinutesDocType {
  DETERIORATION
  PRICE_CHANGE
}

enum MinutesDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum EFacturaStatus {
  NOT_READY
  PREPARED
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  ERROR
}

enum IncomingEInvoiceStatus {
  SYNCED
  LINKED
}

enum MarketplacePlatform {
  GLOVO
  WOLT
  BOLT_FOOD
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

enum IntegrationAuthType {
  OAUTH
  API_KEY
  PARTNER
}

enum ExternalOrderStatus {
  RECEIVED
  ACKNOWLEDGED
  IN_KITCHEN
  READY
  READY_FOR_FISCAL
  FISCALIZED
  DELIVERED
  CANCELLED
  FAILED
}

enum ExternalOrderHistorySource {
  PLATFORM
  BACKEND
  KDS
  POS
  ERP
}

enum KitchenTicketSource {
  POS_TABLE
  MARKETPLACE
}

enum KitchenTicketStatus {
  NEW
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum SaleDraftStatus {
  OPEN
  READY_FOR_FISCAL
  FISCALIZED
  CANCELLED
}

enum MarketplaceMappingStatus {
  MAPPED
  UNMAPPED
  PARTIAL
  BROKEN
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  subdomain String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  licenses  License[]
  locations Location[]
  terminals Terminal[]

  vatRates    VatRate[]
  uoms        Uom[]
  departments Department[]
  categories  Category[]
  skuCounters SkuCounter[]
  products    Product[]
  suppliers   Supplier[]
  customers   Customer[]
  recipes     Recipe[]

  sales                  Sale[]
  stockBalances          StockBalance[]
  stockMoves             StockMove[]
  purchaseReceipts       PurchaseReceipt[]
  transferDocs           TransferDoc[]
  consumptionDocs        ConsumptionDoc[]
  productionDocs         ProductionDoc[]
  inventoryDocs          InventoryDoc[]
  minutesDocs            MinutesDoc[]
  salesInvoices          SalesInvoice[]
  incomingEInvoices      IncomingEInvoice[]
  passwordResetTokens    PasswordResetToken[]
  efacturaLogs           EFacturaLog[]
  externalIntegrations   ExternalIntegration[]
  externalOrders         ExternalOrder[]
  externalOrderHistories ExternalOrderStatusHistory[]
  kitchenTickets         KitchenTicket[]
  saleDrafts             SaleDraft[]
  marketplaceMappings    MarketplaceProductMapping[]

  subscriptions Subscription[]
  invoices      Invoice[]
  tenantModules TenantModule[]
  auditLogs     AuditLog[]
  accountingExportConfigs AccountingExportConfig[]
  accountingStockTypes    AccountingStockType[]
}

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique @default("global")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  efacturaOauthClientId     String?
  efacturaOauthClientSecret String?
  efacturaOauthRedirectUri  String?
  efacturaEnvironment       String? @default("test")
}

model Company {
    id       String  @id @default(cuid())
    tenantId String

  name    String
  code    String?
  isDefault Boolean @default(false)
  cui     String?
  regNo   String?
  address String?
  city    String?
  county  String?
  country String? @default("RO")
  postalCode String?

  bank String?
  iban String?

  email                              String?
  phone                              String?
  contactEmail                       String?
  isVatPayer                         Boolean   @default(true)
  posSyncInterval                    Int       @default(5)
  efacturaEnabled                    Boolean   @default(false)
  efacturaEnvironment                String    @default("test")
  efacturaSellerCountryCode          String    @default("RO")
  efacturaSellerCity                 String?
  efacturaSellerCounty               String?
  efacturaSellerPostalCode           String?
  efacturaContactEmail               String?
  efacturaCertSerial                 String?
  efacturaCertPasswordEnc            String?
  efacturaCertFilename               String?
  efacturaCertUploadedAt             DateTime?
  efacturaOauthClientId              String?
  efacturaOauthClientSecret          String?
  efacturaOauthRedirectUri           String?
  efacturaOauthAccessToken           String?
  efacturaOauthRefreshToken          String?
  efacturaOauthAccessTokenExpiresAt  DateTime?
  efacturaOauthRefreshTokenExpiresAt DateTime?
  efacturaOauthConnectedAt           DateTime?
  efacturaOauthLastError             String?
  invoiceSeries                      String    @default("FAC")
  purchaseSeries                     String    @default("NIR")
  transferSeries                     String    @default("TRF")
  inventorySeries                    String    @default("INV")
  productionSeries                   String    @default("PROD")
  deteriorationSeries                String    @default("PVD")
  priceChangeSeries                  String    @default("PVP")
  customerCodePrefix                 String    @default("CLI")
  supplierCodePrefix                 String    @default("FUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    products Product[]
    suppliers Supplier[]
    customers Customer[]
  purchaseReceipts PurchaseReceipt[]
  incomingEInvoices IncomingEInvoice[]
  salesInvoices SalesInvoice[]
  recipes Recipe[]
  locations Location[]
  terminals Terminal[]
  vatRates VatRate[]
  uoms Uom[]
  departments Department[]
  categories Category[]
  sales Sale[]
    stockBalances StockBalance[]
    stockMoves StockMove[]
    consumptionDocs ConsumptionDoc[]
    productionDocs ProductionDoc[]
    transferDocs TransferDoc[]
  inventoryDocs InventoryDoc[]
  minutesDocs MinutesDoc[]
  userAccesses UserCompanyAccess[]
  accountingExportConfig AccountingExportConfig?
  accountingStockTypes   AccountingStockType[]

    @@index([tenantId])
    @@unique([tenantId, name])
    @@unique([tenantId, code])
  }

model AccountingExportConfig {
  id                    String   @id @default(cuid())
  tenantId              String
  companyId             String   @unique
  exportTarget          String   @default("SAGA")
  articleCodeSource     String   @default("SKU")
  managementAnalytic    String   @default("LOCATION_CODE")
  customerAccount       String   @default("4111")
  supplierAccount       String   @default("401")
  salesAccount          String   @default("707")
  expenseAccount        String   @default("607")
  inventoryAccount      String   @default("371")
  vatCollectedAccount   String   @default("4427")
  vatDeductibleAccount  String   @default("4426")
  cashAccount           String   @default("5311")
  cardAccount           String   @default("5121")
  defaultStockTypeId    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultStockType AccountingStockType? @relation("DefaultAccountingStockType", fields: [defaultStockTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([defaultStockTypeId])
}

model AccountingStockType {
  id                String   @id @default(cuid())
  tenantId          String
  companyId         String
  code              String
  name              String
  inventoryAccount  String
  expenseAccount    String
  salesAccount      String?
  analyticMode      String   @default("NONE")
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products             Product[]
  exportConfigDefaults AccountingExportConfig[] @relation("DefaultAccountingStockType")

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([companyId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  companyAccesses UserCompanyAccess[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserCompanyAccess {
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model License {
  id          String   @id @default(cuid())
  tenantId    String
  keyHash     String   @unique
  keyPrefix   String
  expiresAt   DateTime
  isSuspended Boolean  @default(false)

  modDashboard    Boolean @default(true)
  modDocuments    Boolean @default(true)
  modInventory    Boolean @default(true)
  modNomenclature Boolean @default(true)
  modSettings     Boolean @default(true)
  modPos          Boolean @default(true)
  modReports      Boolean @default(false)

  limitLocations Int @default(1)
  limitTerminals Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  company              Company?              @relation(fields: [companyId], references: [id])
  terminals            Terminal[]
  sales                Sale[]
  stockBalances        StockBalance[]
  stockMoves           StockMove[]
  purchaseReceipts     PurchaseReceipt[]
  transferDocsFrom     TransferDoc[]         @relation("TransferFromLocation")
  transferDocsTo       TransferDoc[]         @relation("TransferToLocation")
  consumptionDocs      ConsumptionDoc[]
  productionDocs       ProductionDoc[]
  inventoryDocs        InventoryDoc[]
  minutesDocs          MinutesDoc[]
  salesInvoices        SalesInvoice[]
  externalIntegrations ExternalIntegration[]
  externalOrders       ExternalOrder[]
  kitchenTickets       KitchenTicket[]
  saleDrafts           SaleDraft[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Terminal {
  id                 String  @id @default(cuid())
  tenantId           String
  companyId          String?
  locationId         String?
  deviceId           String
  label              String?
  isLockedToLocation Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])
  sales    Sale[]

  @@unique([tenantId, companyId, deviceId])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([locationId])
}

model VatRate {
  id         String   @id @default(cuid())
  tenantId   String
  companyId  String?
  name       String
  rate       Int
  fiscalCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  company       Company?              @relation(fields: [companyId], references: [id])
  products      Product[]
  receiptItems  PurchaseReceiptItem[]
  transferItems TransferDocItem[]

  @@unique([tenantId, companyId, rate])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Uom {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  company          Company?              @relation(fields: [companyId], references: [id])
  stockProducts    Product[]             @relation("StockUom")
  purchaseProducts Product[]             @relation("PurchaseUom")
  receiptItems     PurchaseReceiptItem[]
  transferItems    TransferDocItem[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  company            Company?            @relation(fields: [companyId], references: [id])
  categories         Category[]
  products           Product[]
  kitchenTicketItems KitchenTicketItem[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Category {
  id             String   @id @default(cuid())
  tenantId       String
  companyId      String?
  departmentId   String?
  name           String
  imageUrl       String?
  isActive       Boolean  @default(true)
  isVisibleInPos Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  company    Company?    @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  products   Product[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([departmentId])
}

model SkuCounter {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Product {
    id       String @id @default(cuid())
    tenantId String
    companyId String?

  sku      String
  name     String
  imageUrl String?
  class    ProductClass @default(PRODUS_FIN)

  vatRateId      String
  uomId          String
  purchaseUomId  String?
  purchaseFactor Decimal @default(1)

  departmentId String?
  categoryId   String?
  accountingStockTypeId String?
  accountingItemCode String?

  price          Decimal        @default(0)
  costPrice      Decimal        @default(0)
  isActive       Boolean        @default(true)
  isVisibleInPos Boolean        @default(true)
  isSgr          Boolean        @default(false)
  sgrValue       Decimal        @default(0)
  productionMode ProductionMode @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    tenant      Tenant      @relation(fields: [tenantId], references: [id])
    company     Company?    @relation(fields: [companyId], references: [id])
    vatRate     VatRate     @relation(fields: [vatRateId], references: [id])
  uom         Uom         @relation("StockUom", fields: [uomId], references: [id])
  purchaseUom Uom?        @relation("PurchaseUom", fields: [purchaseUomId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  category    Category?   @relation(fields: [categoryId], references: [id])
  accountingStockType AccountingStockType? @relation(fields: [accountingStockTypeId], references: [id])

  barcodes                 ProductBarcode[]
  saleItems                SaleItem[]
  stockBalances            StockBalance[]
  stockMoves               StockMove[]
  receiptItems             PurchaseReceiptItem[]
  transferItems            TransferDocItem[]
  consumptionItems         ConsumptionDocItem[]  @relation("ConsumptionIngredientProduct")
  finishedConsumptionItems ConsumptionDocItem[]  @relation("ConsumptionFinishedProduct")
  productionItems          ProductionDocItem[]
  inventoryItems           InventoryDocItem[]
  salesInvoiceItems        SalesInvoiceItem[]
  minutesDocItems          MinutesDocItem[]
  externalOrderItems       ExternalOrderItem[]
  kitchenTicketItems       KitchenTicketItem[]

  recipe              Recipe?                     @relation("RecipeProduct")
  usedInRecipes       RecipeItem[]                @relation("RecipeIngredientProduct")
  marketplaceMappings MarketplaceProductMapping[]
  incomingEInvoiceItems IncomingEInvoiceItem[]

    @@unique([tenantId, companyId, sku])
    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([tenantId, name])
    @@index([companyId])
    @@index([departmentId])
    @@index([categoryId])
    @@index([purchaseUomId])
    @@index([accountingStockTypeId])
  }

model Recipe {
    id        String       @id @default(cuid())
    tenantId  String
    companyId String?
    productId String       @unique
  code      String?
  name      String?
  notes     String?
  yieldQty  Decimal      @default(1)
  status    RecipeStatus @default(DRAFT)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

    tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    company Company?     @relation(fields: [companyId], references: [id])
    product Product      @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
    items   RecipeItem[]

    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([productId])
    @@index([status])
  }

model RecipeItem {
  id           String   @id @default(cuid())
  recipeId     String
  ingredientId String
  qty          Decimal
  lossPercent  Decimal  @default(0)
  sortOrder    Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Product @relation("RecipeIngredientProduct", fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([sortOrder])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  barcode   String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
}

model Supplier {
    id         String   @id @default(cuid())
    tenantId   String
    companyId  String?
    name       String
  code       String?
  cif        String?
  regCom     String?
  address    String?
  city       String?
  county     String?
  country    String?
  postalCode String?
  phone      String?
  email      String?
  vatPayer   Boolean?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

    tenant   Tenant            @relation(fields: [tenantId], references: [id])
    company  Company?          @relation(fields: [companyId], references: [id])
    receipts PurchaseReceipt[]
    incomingEInvoices IncomingEInvoice[]

    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([tenantId, name])
    @@index([companyId])
  }

model Customer {
    id         String   @id @default(cuid())
    tenantId   String
    companyId  String?
    name       String
  code       String?
  cif        String?
  regNo      String?
  address    String?
  city       String?
  county     String?
  country    String?
  postalCode String?
  phone      String?
  email      String?
  vatPayer   Boolean?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

    tenant   Tenant         @relation(fields: [tenantId], references: [id])
    company  Company?       @relation(fields: [companyId], references: [id])
    invoices SalesInvoice[]

    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([tenantId, name])
    @@index([companyId])
  }

model Sale {
    id              String  @id @default(cuid())
    tenantId        String
    companyId       String?
    locationId      String
  terminalId      String?
  externalOrderId String? @unique

  clientSaleId String?
  receiptNo    String?
  soldAt       DateTime

  total Decimal @default(0)

  paymentType  PaymentType @default(CASH)
  cashAmount   Decimal?    @db.Decimal(12, 2)
  cardAmount   Decimal?    @db.Decimal(12, 2)
  operatorName String?

  createdAt DateTime @default(now())

    tenant        Tenant         @relation(fields: [tenantId], references: [id])
    company       Company?       @relation(fields: [companyId], references: [id])
    location      Location       @relation(fields: [locationId], references: [id])
  terminal      Terminal?      @relation(fields: [terminalId], references: [id])
  externalOrder ExternalOrder? @relation(fields: [externalOrderId], references: [id])

  items           SaleItem[]
  consumptionDocs ConsumptionDoc[]

    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([locationId])
  @@index([terminalId])
  @@index([soldAt])
  @@index([externalOrderId])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String

  qty       Decimal
  unitPrice Decimal
  vatRate   Int

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model StockBalance {
    id         String @id @default(cuid())
    tenantId   String
    companyId  String?
    locationId String
    productId  String

  qty Decimal @default(0)

    tenant   Tenant   @relation(fields: [tenantId], references: [id])
    company  Company? @relation(fields: [companyId], references: [id])
    location Location @relation(fields: [locationId], references: [id])
    product  Product  @relation(fields: [productId], references: [id])

    @@unique([tenantId, companyId, locationId, productId])
    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([locationId])
    @@index([productId])
  }

model StockMove {
    id         String @id @default(cuid())
    tenantId   String
    companyId  String?
    locationId String
    productId  String

  type StockMoveType
  qty  Decimal

  refType RefType?
  refId   String?
  note    String?

  createdAt DateTime @default(now())

    tenant   Tenant   @relation(fields: [tenantId], references: [id])
    company  Company? @relation(fields: [companyId], references: [id])
    location Location @relation(fields: [locationId], references: [id])
    product  Product  @relation(fields: [productId], references: [id])

    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([locationId])
  @@index([productId])
  @@index([refType, refId])
}

model ConsumptionDoc {
    id         String   @id @default(cuid())
    tenantId   String
    companyId  String?
    locationId String
  saleId     String?
  docNo      String
  docDate    DateTime
  note       String?
