  updatedAt  DateTime         @updatedAt

    tenant   Tenant           @relation(fields: [tenantId], references: [id])
    company  Company?         @relation(fields: [companyId], references: [id])
    location Location         @relation(fields: [locationId], references: [id])
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id])
  items    MinutesDocItem[]

    @@unique([tenantId, companyId, docNo])
    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([locationId])
  @@index([warehouseId])
  @@index([docDate])
  @@index([type])
  @@index([status])
}

model MinutesDocItem {
  id           String   @id @default(cuid())
  minutesDocId String
  productId    String
  qty          Decimal  @default(0)
  unitValue    Decimal  @default(0)
  oldPrice     Decimal?
  newPrice     Decimal?
  lineValue    Decimal  @default(0)
  note         String?
  createdAt    DateTime @default(now())

  minutesDoc MinutesDoc @relation(fields: [minutesDocId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([minutesDocId])
  @@index([productId])
}

model SalesInvoice {
    id                  String             @id @default(cuid())
    tenantId            String
    companyId           String?
    locationId          String
  customerId          String?
  docNo               String
  docDate             DateTime
  dueDate             DateTime?
  customerName        String
  customerCode        String?
  customerCif         String?
  customerRegNo       String?
  customerAddress     String?
  customerEmail       String?
  customerPhone       String?
  currency            CurrencyCode       @default(RON)
  fxRate              Decimal            @default(1)
  totalNetFc          Decimal            @default(0)
  totalDiscountFc     Decimal            @default(0)
  totalVatFc          Decimal            @default(0)
  totalGrossFc        Decimal            @default(0)
  totalSgrFc          Decimal            @default(0)
  totalWithSgrFc      Decimal            @default(0)
  totalNetRon         Decimal            @default(0)
  totalDiscountRon    Decimal            @default(0)
  totalVatRon         Decimal            @default(0)
  totalGrossRon       Decimal            @default(0)
  totalSgrRon         Decimal            @default(0)
  totalWithSgrRon     Decimal            @default(0)
  invoiceTypeCode     String             @default("380")
  isEfacturaRequired  Boolean            @default(true)
  efacturaStatus      EFacturaStatus     @default(NOT_READY)
  efacturaUploadIndex String?
  efacturaDownloadId  String?
  efacturaPreparedAt  DateTime?
  efacturaSentAt      DateTime?
  efacturaValidatedAt DateTime?
  efacturaLastCheckAt DateTime?
  efacturaDownloadedAt DateTime?
  efacturaXmlText     String?
  efacturaErrorText   String?
  note                String?
  status              SalesInvoiceStatus @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

    tenant       Tenant             @relation(fields: [tenantId], references: [id])
    company      Company?           @relation(fields: [companyId], references: [id])
    location     Location           @relation(fields: [locationId], references: [id])
  customer     Customer?          @relation(fields: [customerId], references: [id])
  items        SalesInvoiceItem[]
  efacturaLogs EFacturaLog[]

    @@unique([tenantId, companyId, docNo])
    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([locationId])
  @@index([customerId])
  @@index([docDate])
  @@index([status])
}

model SalesInvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  productId       String
  productName     String   @default("")
  productCode     String?
  uomCode         String?
  uomStandardCode String?
  vatCategoryCode String?
  qty             Decimal  @default(0)
  unitPriceFc     Decimal  @default(0)
  vatRateValue    Decimal  @default(19)
  discountPercent Decimal  @default(0)
  discountAmountFc Decimal @default(0)
  lineNetFc       Decimal  @default(0)
  lineVatFc       Decimal  @default(0)
  lineGrossFc     Decimal  @default(0)
  sgrUnitFc       Decimal  @default(0)
  sgrTotalFc      Decimal  @default(0)
  discountAmountRon Decimal @default(0)
  lineNetRon      Decimal  @default(0)
  lineVatRon      Decimal  @default(0)
  lineGrossRon    Decimal  @default(0)
  sgrTotalRon     Decimal  @default(0)
  createdAt       DateTime @default(now())

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model EFacturaLog {
  id        String   @id @default(cuid())
  tenantId  String
  invoiceId String
  stage     String
  success   Boolean  @default(false)
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([createdAt])
}

model ExternalIntegration {
  id             String              @id @default(cuid())
  tenantId       String
  locationId     String?
  platform       MarketplacePlatform
  status         IntegrationStatus   @default(DISCONNECTED)
  authType       IntegrationAuthType @default(PARTNER)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  merchantId     String?
  storeId        String?
  webhookSecret  String?
  settingsJson   Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  orders              ExternalOrder[]
  marketplaceMappings MarketplaceProductMapping[]

  @@index([tenantId])
  @@index([locationId])
  @@index([platform])
  @@index([status])
}

model ExternalOrder {
  id                  String              @id @default(cuid())
  tenantId            String
  locationId          String
  integrationId       String?
  platform            MarketplacePlatform
  externalOrderId     String
  externalOrderNumber String?
  status              ExternalOrderStatus @default(RECEIVED)
  customerName        String?
  customerPhone       String?
  customerNote        String?
  paymentLabel        String?
  currency            CurrencyCode        @default(RON)
  subtotal            Decimal             @default(0) @db.Decimal(12, 2)
  total               Decimal             @default(0) @db.Decimal(12, 2)
  rawPayloadJson      Json?
  placedAt            DateTime?
  acknowledgedAt      DateTime?
  readyAt             DateTime?
  fiscalizedAt        DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  integration ExternalIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  items         ExternalOrderItem[]
  statusHistory ExternalOrderStatusHistory[]
  kitchenTicket KitchenTicket?
  saleDraft     SaleDraft?
  sale          Sale?

  @@unique([tenantId, platform, externalOrderId])
  @@index([tenantId])
  @@index([locationId])
  @@index([integrationId])
  @@index([status])
  @@index([createdAt])
}

model ExternalOrderItem {
  id                String                   @id @default(cuid())
  externalOrderId   String
  externalLineId    String?
  externalProductId String?
  name              String
  sku               String?
  qty               Decimal                  @default(0) @db.Decimal(12, 3)
  unitPrice         Decimal                  @default(0) @db.Decimal(12, 2)
  vatRate           Int?
  modifiersJson     Json?
  note              String?
  erpProductId      String?
  mappingStatus     MarketplaceMappingStatus @default(UNMAPPED)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  externalOrder ExternalOrder @relation(fields: [externalOrderId], references: [id], onDelete: Cascade)
  erpProduct    Product?      @relation(fields: [erpProductId], references: [id], onDelete: SetNull)

  @@index([externalOrderId])
  @@index([externalProductId])
  @@index([erpProductId])
  @@index([mappingStatus])
}

model ExternalOrderStatusHistory {
  id              String                     @id @default(cuid())
  tenantId        String
  externalOrderId String
  status          ExternalOrderStatus
  source          ExternalOrderHistorySource
  message         String?
  payloadJson     Json?
  createdAt       DateTime                   @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalOrder ExternalOrder @relation(fields: [externalOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([externalOrderId])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model KitchenTicket {
  id              String              @id @default(cuid())
  tenantId        String
  locationId      String
  externalOrderId String?             @unique
  source          KitchenTicketSource
  status          KitchenTicketStatus @default(NEW)
  displayNumber   String?
  station         String?
  note            String?
  sentToKdsAt     DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  externalOrder ExternalOrder?      @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)
  items         KitchenTicketItem[]

  @@index([tenantId])
  @@index([locationId])
  @@index([status])
  @@index([source])
}

model KitchenTicketItem {
  id              String   @id @default(cuid())
  kitchenTicketId String
  productId       String?
  name            String
  qty             Decimal  @default(0) @db.Decimal(12, 3)
  departmentId    String?
  station         String?
  note            String?
  modifiersJson   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  kitchenTicket KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([kitchenTicketId])
  @@index([productId])
  @@index([departmentId])
}

model SaleDraft {
  id              String          @id @default(cuid())
  tenantId        String
  locationId      String
  externalOrderId String?         @unique
  status          SaleDraftStatus @default(OPEN)
  cartJson        Json
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @default(0) @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  externalOrder ExternalOrder? @relation(fields: [externalOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
  @@index([status])
}

model MarketplaceProductMapping {
  id                String                   @id @default(cuid())
  tenantId          String
  integrationId     String
  externalProductId String
  externalName      String?
  erpProductId      String?
  status            MarketplaceMappingStatus @default(UNMAPPED)
  lastSeenAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration ExternalIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  erpProduct  Product?            @relation(fields: [erpProductId], references: [id], onDelete: SetNull)

  @@unique([integrationId, externalProductId])
  @@index([tenantId])
  @@index([integrationId])
  @@index([erpProductId])
  @@index([status])
}

enum BillingStatus {
  OK
  FAILED
  UNPAID
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIAL
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  UNPAID
  OVERDUE
  CANCELLED
}

enum ModuleTarget {
  GESTIUNE
  POS
  BOTH
}

enum AuditActorType {
  SYSTEM
  OWNER
  USER
}

model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  priceMonthly Decimal      @default(0) @db.Decimal(12, 2)
  priceYearly  Decimal      @default(0) @db.Decimal(12, 2)
  currency     CurrencyCode @default(RON)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]

  @@index([isActive])
}

model AppModule {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  target      ModuleTarget @default(BOTH)
  isCore      Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenantModules TenantModule[]

  @@index([isActive])
}

model TenantModule {
  id         String   @id @default(cuid())
  tenantId   String
  moduleId   String
  enabled    Boolean  @default(true)
  limitValue Int?
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@index([enabled])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  planId             String
  vivaSubscriptionId String?
  vivaOrderCode      String?
  billingCycle       BillingCycle
  status             SubscriptionStatus @default(TRIAL)
  billingStatus      BillingStatus      @default(OK)
  price              Decimal            @default(0) @db.Decimal(12, 2)
  currency           CurrencyCode       @default(RON)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  nextBillingDate    DateTime?
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([billingStatus])
  @@index([vivaSubscriptionId])
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  number         String        @unique
  issueDate      DateTime
  dueDate        DateTime
  paidAt         DateTime?
  amount         Decimal       @default(0) @db.Decimal(12, 2)
  currency       CurrencyCode  @default(RON)
  status         InvoiceStatus @default(DRAFT)
  externalRef    String?
  downloadUrl    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model AuditLog {
  id         String         @id @default(cuid())
  tenantId   String?
  actorType  AuditActorType @default(SYSTEM)
  actorId    String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorType])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model TenantBackup {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String?
  createdByUserId String?
  label           String?
  fileName        String
  filePath        String
  fileSizeBytes   Int      @default(0)
  tableCounts     Json?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([companyId])
}
