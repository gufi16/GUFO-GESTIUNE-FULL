generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE
  CHEF
  KITCHEN_HELPER
  KITCHEN_OPERATOR
}

enum TerminalDeviceType {
  POS
  KDS
}

enum ProductClass {
  PRODUS_FIN
  MATERIE_PRIMA
  MARFA
  AMBALAJE
  AMBALAJ_SGR
  CONSUMABILE
  SEMIFABRICATE
  REZIDUALE
  ALTE_MATERIALE
  SERVICIU_VANDUT
  DISCOUNT_FINANCIAR_IESIRI
  DISCOUNT_COMERCIAL_IESIRI
  TAXA_VERDE
}

enum ProductionMode {
  AUTO
  MANUAL
}

enum WarehouseType {
  GENERAL
  RAW_MATERIALS
  FINISHED_GOODS
  BAR
  KITCHEN
  PACKAGING
}

enum StockCostMethod {
  AVG
  FIFO
  FEFO
}

enum StockMoveType {
  IN
  OUT
  TRANSFER
  ADJUST
}

enum RefType {
  SALE
  PURCHASE
  TRANSFER
  INVENTORY
  CONSUMPTION
  PRODUCTION
  MINUTES
}

enum CurrencyCode {
  RON
  EUR
  USD
  HUF
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum RecipeStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PaymentType {
  CASH
  CARD
  MIXED
}

enum InventoryStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum ConsumptionDocStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

enum ConsumptionDocSource {
  MANUAL
  POS_RECIPE
  SALES_AGGREGATE
}

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum MinutesDocType {
  DETERIORATION
  PRICE_CHANGE
}

enum MinutesDocStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum EFacturaStatus {
  NOT_READY
  PREPARED
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  ERROR
}

enum IncomingEInvoiceStatus {
  SYNCED
  LINKED
}

enum MarketplacePlatform {
  GLOVO
  WOLT
  BOLT_FOOD
}

enum IntegrationStatus {
  ACTIVE
  DISCONNECTED
  ERROR
}

enum IntegrationAuthType {
  OAUTH
  API_KEY
  PARTNER
}

enum ExternalOrderStatus {
  RECEIVED
  ACKNOWLEDGED
  IN_KITCHEN
  READY
  READY_FOR_FISCAL
  FISCALIZED
  DELIVERED
  CANCELLED
  FAILED
}

enum ExternalOrderHistorySource {
  PLATFORM
  BACKEND
  KDS
  POS
  ERP
}

enum KitchenTicketSource {
  POS_TABLE
  MARKETPLACE
}

enum KitchenTicketStatus {
  NEW
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum SaleDraftStatus {
  OPEN
  READY_FOR_FISCAL
  FISCALIZED
  CANCELLED
}

enum MarketplaceMappingStatus {
  MAPPED
  UNMAPPED
  PARTIAL
  BROKEN
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  subdomain String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies Company[]
  users     User[]
  licenses  License[]
  locations Location[]
  terminals Terminal[]

  vatRates    VatRate[]
  uoms        Uom[]
  departments Department[]
  categories  Category[]
  skuCounters SkuCounter[]
  products    Product[]
  suppliers   Supplier[]
  customers   Customer[]
  recipes     Recipe[]

  sales                  Sale[]
  warehouses             Warehouse[]
  stockBalances          StockBalance[]
  stockLots              StockLot[]
  stockMoves             StockMove[]
  purchaseReceipts       PurchaseReceipt[]
  transferDocs           TransferDoc[]
  consumptionDocs        ConsumptionDoc[]
  productionDocs         ProductionDoc[]
  inventoryDocs          InventoryDoc[]
  minutesDocs            MinutesDoc[]
  salesInvoices          SalesInvoice[]
  incomingEInvoices      IncomingEInvoice[]
  passwordResetTokens    PasswordResetToken[]
  efacturaLogs           EFacturaLog[]
  externalIntegrations   ExternalIntegration[]
  externalOrders         ExternalOrder[]
  externalOrderHistories ExternalOrderStatusHistory[]
  kitchenTickets         KitchenTicket[]
  saleDrafts             SaleDraft[]
  marketplaceMappings    MarketplaceProductMapping[]

  subscriptions Subscription[]
  invoices      Invoice[]
  tenantModules TenantModule[]
  auditLogs     AuditLog[]
  accountingExportConfigs AccountingExportConfig[]
  accountingStockTypes    AccountingStockType[]
  backups               TenantBackup[]
  eTransportNotices    ETransportNotice[]
  anafCredentials      CompanyAnafCredential[]
}

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique @default("global")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  efacturaOauthClientId     String?
  efacturaOauthClientSecret String?
  efacturaOauthRedirectUri  String?
  efacturaEnvironment       String? @default("test")
}

model Company {
    id       String  @id @default(cuid())
    tenantId String

  name    String
  code    String?
  isDefault Boolean @default(false)
  cui     String?
  regNo   String?
  address String?
  city    String?
  county  String?
  country String? @default("RO")
  postalCode String?

  bank String?
  iban String?

  email                              String?
  phone                              String?
  contactEmail                       String?
  isVatPayer                         Boolean   @default(true)
  posSyncInterval                    Int       @default(5)
  efacturaEnabled                    Boolean   @default(false)
  efacturaEnvironment                String    @default("test")
  efacturaSellerCountryCode          String    @default("RO")
  efacturaSellerCity                 String?
  efacturaSellerCounty               String?
  efacturaSellerPostalCode           String?
  efacturaContactEmail               String?
  efacturaCertSerial                 String?
  efacturaCertPasswordEnc            String?
  efacturaCertFilename               String?
  efacturaCertUploadedAt             DateTime?
  efacturaOauthClientId              String?
  efacturaOauthClientSecret          String?
  efacturaOauthRedirectUri           String?
  efacturaOauthAccessToken           String?
  efacturaOauthRefreshToken          String?
  efacturaOauthAccessTokenExpiresAt  DateTime?
  efacturaOauthRefreshTokenExpiresAt DateTime?
  efacturaOauthConnectedAt           DateTime?
  efacturaOauthLastError             String?
  etransportOauthClientId            String?
  etransportOauthClientSecret        String?
  etransportOauthRedirectUri         String?
  etransportOauthAccessToken         String?
  etransportOauthRefreshToken        String?
  etransportOauthAccessTokenExpiresAt DateTime?
  etransportOauthRefreshTokenExpiresAt DateTime?
  etransportOauthConnectedAt         DateTime?
  etransportOauthLastError           String?
  invoiceSeries                      String    @default("FAC")
  purchaseSeries                     String    @default("NIR")
  transferSeries                     String    @default("TRF")
  inventorySeries                    String    @default("INV")
  multiWarehouseEnabled              Boolean   @default(false)
  warehouseFilterEnabled             Boolean   @default(false)
  requireWarehouseOnDocuments        Boolean   @default(false)
  autoSelectSingleWarehouse          Boolean   @default(true)
  warehouseLabel                     String    @default("Gestiune")
  consumptionSeries                  String    @default("BC")
  productionSeries                   String    @default("PROD")
  deteriorationSeries                String    @default("PVD")
  priceChangeSeries                  String    @default("PVP")
  customerCodePrefix                 String    @default("CLI")
  supplierCodePrefix                 String    @default("FUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  warehouses Warehouse[]
  suppliers Supplier[]
    customers Customer[]
  purchaseReceipts PurchaseReceipt[]
  incomingEInvoices IncomingEInvoice[]
  salesInvoices SalesInvoice[]
  recipes Recipe[]
  locations Location[]
  terminals Terminal[]
  vatRates VatRate[]
  uoms Uom[]
  departments Department[]
  categories Category[]
  sales Sale[]
    stockBalances StockBalance[]
    stockLots StockLot[]
    stockMoves StockMove[]
  consumptionDocs ConsumptionDoc[]
  productionDocs ProductionDoc[]
  transferDocs TransferDoc[]
  eTransportNotices ETransportNotice[]
  inventoryDocs InventoryDoc[]
  minutesDocs MinutesDoc[]
  userAccesses UserCompanyAccess[]
  accountingExportConfig AccountingExportConfig?
  accountingStockTypes   AccountingStockType[]
  anafCredentials CompanyAnafCredential[]

    @@index([tenantId])
    @@unique([tenantId, name])
    @@unique([tenantId, code])
  }

model CompanyAnafCredential {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String

  label      String
  isDefault  Boolean @default(false)

  certSerial      String?
  certPasswordEnc String?
  certFilename    String?
  certUploadedAt  DateTime?

  efacturaOauthAccessToken           String?
  efacturaOauthRefreshToken          String?
  efacturaOauthAccessTokenExpiresAt  DateTime?
  efacturaOauthRefreshTokenExpiresAt DateTime?
  efacturaOauthConnectedAt           DateTime?
  efacturaOauthLastError             String?

  etransportOauthAccessToken           String?
  etransportOauthRefreshToken          String?
  etransportOauthAccessTokenExpiresAt  DateTime?
  etransportOauthRefreshTokenExpiresAt DateTime?
  etransportOauthConnectedAt           DateTime?
  etransportOauthLastError             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
  @@index([companyId, isDefault])
}

model AccountingExportConfig {
  id                    String   @id @default(cuid())
  tenantId              String
  companyId             String   @unique
  exportTarget          String   @default("SAGA")
  articleCodeSource     String   @default("SKU")
  managementAnalytic    String   @default("LOCATION_CODE")
  customerAccount       String   @default("4111")
  supplierAccount       String   @default("401")
  salesAccount          String   @default("707")
  expenseAccount        String   @default("607")
  inventoryAccount      String   @default("371")
  vatCollectedAccount   String   @default("4427")
  vatDeductibleAccount  String   @default("4426")
  cashAccount           String   @default("5311")
  cardAccount           String   @default("5121")
  defaultStockTypeId    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultStockType AccountingStockType? @relation("DefaultAccountingStockType", fields: [defaultStockTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([defaultStockTypeId])
}

model AccountingStockType {
  id                String   @id @default(cuid())
  tenantId          String
  companyId         String
  code              String
  name              String
  inventoryAccount  String
  expenseAccount    String
  salesAccount      String?
  analyticMode      String   @default("NONE")
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products             Product[]
  exportConfigDefaults AccountingExportConfig[] @relation("DefaultAccountingStockType")

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([companyId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  name         String
  imageUrl     String?
  passwordHash String
  posPinHash   String?
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  companyAccesses UserCompanyAccess[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserCompanyAccess {
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
}

model License {
  id          String   @id @default(cuid())
  tenantId    String
  keyHash     String   @unique
  keyPrefix   String
  expiresAt   DateTime
  isSuspended Boolean  @default(false)

  modDashboard    Boolean @default(true)
  modDocuments    Boolean @default(true)
  modInventory    Boolean @default(true)
  modNomenclature Boolean @default(true)
  modSettings     Boolean @default(true)
  modPos          Boolean @default(true)
  modKds          Boolean @default(false)
  modReports      Boolean @default(false)

  limitLocations  Int @default(1)
  limitTerminals  Int @default(1)
  limitKdsDevices Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Location {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  name      String
  code      String
  address   String?
  city      String?
  county    String?
  country   String?  @default("RO")
  postalCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  company              Company?              @relation(fields: [companyId], references: [id])
  terminals            Terminal[]
  sales                Sale[]
  warehouses           Warehouse[]
  stockBalances        StockBalance[]
  stockLots            StockLot[]
  stockMoves           StockMove[]
  purchaseReceipts     PurchaseReceipt[]
  transferDocsFrom     TransferDoc[]         @relation("TransferFromLocation")
  transferDocsTo       TransferDoc[]         @relation("TransferToLocation")
  consumptionDocs      ConsumptionDoc[]
  productionDocs       ProductionDoc[]
  inventoryDocs        InventoryDoc[]
  minutesDocs          MinutesDoc[]
  salesInvoices        SalesInvoice[]
  externalIntegrations ExternalIntegration[]
  externalOrders       ExternalOrder[]
  kitchenTickets       KitchenTicket[]
  saleDrafts           SaleDraft[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Warehouse {
  id         String        @id @default(cuid())
  tenantId   String
  companyId  String?
  locationId String
  code       String
  name       String
  type       WarehouseType @default(GENERAL)
  isDefault  Boolean       @default(false)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  company  Company? @relation(fields: [companyId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  stockBalances    StockBalance[]
  stockLots        StockLot[]
  stockMoves       StockMove[]
  purchaseReceipts PurchaseReceipt[]
  consumptionDocs  ConsumptionDoc[]
  productionDocs   ProductionDoc[]
  inventoryDocs    InventoryDoc[]
  minutesDocs      MinutesDoc[]
  transferDocsFrom TransferDoc[] @relation("TransferFromWarehouse")
  transferDocsTo   TransferDoc[] @relation("TransferToWarehouse")

  @@unique([tenantId, companyId, locationId, code])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([locationId])
}

model Terminal {
  id                 String  @id @default(cuid())
  tenantId           String
  companyId          String?
  locationId         String?
  deviceId           String
  deviceType         TerminalDeviceType @default(POS)
  label              String?
  isLockedToLocation Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])
  sales    Sale[]

  @@unique([tenantId, companyId, deviceId])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([locationId])
}

model VatRate {
  id         String   @id @default(cuid())
  tenantId   String
  companyId  String?
  name       String
  rate       Int
  fiscalCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  company       Company?              @relation(fields: [companyId], references: [id])
  products      Product[]
  receiptItems  PurchaseReceiptItem[]
  transferItems TransferDocItem[]

  @@unique([tenantId, companyId, rate])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Uom {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  code      String
  name      String
  standardCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  company          Company?              @relation(fields: [companyId], references: [id])
  stockProducts    Product[]             @relation("StockUom")
  purchaseProducts Product[]             @relation("PurchaseUom")
  receiptItems     PurchaseReceiptItem[]
  transferItems    TransferDocItem[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  company            Company?            @relation(fields: [companyId], references: [id])
  categories         Category[]
  products           Product[]
  kitchenTicketItems KitchenTicketItem[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
}

model Category {
  id             String   @id @default(cuid())
  tenantId       String
  companyId      String?
  departmentId   String?
  name           String
  imageUrl       String?
  isActive       Boolean  @default(true)
  isVisibleInPos Boolean  @default(true)
  createdAt      DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  company    Company?    @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  products   Product[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@index([companyId])
  @@index([departmentId])
}

model SkuCounter {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Product {
    id       String @id @default(cuid())
    tenantId String
    companyId String?

  sku      String
  name     String
  imageUrl String?
  class    ProductClass @default(PRODUS_FIN)
  ncCode   String?
  isFiscalRiskProduct Boolean @default(false)
  netWeightKg Decimal @default(0)
  grossWeightKg Decimal @default(0)

  vatRateId      String
  uomId          String
  purchaseUomId  String?
  purchaseFactor Decimal @default(1)

  departmentId String?
  categoryId   String?
  accountingStockTypeId String?
  accountingItemCode String?

  price          Decimal        @default(0)
  costPrice      Decimal        @default(0)
  trackLot       Boolean        @default(false)
  trackExpiry    Boolean        @default(false)
  costMethod     StockCostMethod @default(AVG)
  isActive       Boolean        @default(true)
  isMenu         Boolean        @default(false)
  posMenuCategory String?
  isVisibleInPos Boolean        @default(true)
  publishToGlovo Boolean        @default(false)
  isSgr          Boolean        @default(false)
  sgrValue       Decimal        @default(0)
  productionMode ProductionMode @default(AUTO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    tenant      Tenant      @relation(fields: [tenantId], references: [id])
    company     Company?    @relation(fields: [companyId], references: [id])
    vatRate     VatRate     @relation(fields: [vatRateId], references: [id])
  uom         Uom         @relation("StockUom", fields: [uomId], references: [id])
  purchaseUom Uom?        @relation("PurchaseUom", fields: [purchaseUomId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  category    Category?   @relation(fields: [categoryId], references: [id])
  accountingStockType AccountingStockType? @relation(fields: [accountingStockTypeId], references: [id])

  barcodes                 ProductBarcode[]
  saleItems                SaleItem[]
  stockBalances            StockBalance[]
  stockLots                StockLot[]
  stockMoves               StockMove[]
  receiptItems             PurchaseReceiptItem[]
  transferItems            TransferDocItem[]
  eTransportNoticeItems    ETransportNoticeItem[]
  consumptionItems         ConsumptionDocItem[]  @relation("ConsumptionIngredientProduct")
  finishedConsumptionItems ConsumptionDocItem[]  @relation("ConsumptionFinishedProduct")
  productionItems          ProductionDocItem[]
  inventoryItems           InventoryDocItem[]
  salesInvoiceItems        SalesInvoiceItem[]
  minutesDocItems          MinutesDocItem[]
  externalOrderItems       ExternalOrderItem[]
  kitchenTicketItems       KitchenTicketItem[]

  recipe              Recipe?                     @relation("RecipeProduct")
  usedInRecipes       RecipeItem[]                @relation("RecipeIngredientProduct")
  marketplaceMappings MarketplaceProductMapping[]
  incomingEInvoiceItems IncomingEInvoiceItem[]

    @@unique([tenantId, companyId, sku])
    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([tenantId, name])
    @@index([companyId])
    @@index([departmentId])
    @@index([categoryId])
    @@index([purchaseUomId])
    @@index([accountingStockTypeId])
  }

model Recipe {
    id        String       @id @default(cuid())
    tenantId  String
    companyId String?
    productId String       @unique
  code      String?
  name      String?
  notes     String?
  yieldQty  Decimal      @default(1)
  status    RecipeStatus @default(DRAFT)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

    tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    company Company?     @relation(fields: [companyId], references: [id])
    product Product      @relation("RecipeProduct", fields: [productId], references: [id], onDelete: Cascade)
    items   RecipeItem[]

    @@index([tenantId])
    @@index([tenantId, companyId])
    @@index([companyId])
    @@index([productId])
    @@index([status])
  }

model RecipeItem {
  id           String   @id @default(cuid())
  recipeId     String
  ingredientId String
  qty          Decimal
  lossPercent  Decimal  @default(0)
  sortOrder    Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Product @relation("RecipeIngredientProduct", fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([sortOrder])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  barcode   String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([productId])
}

