SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Daily DB backup at 02:30
30 2 * * * /opt/poshard/gufo-gestiune-full/ops/hetzner/backup-db.sh >> /var/log/gufo-backup.log 2>&1

# Health check every 5 minutes
*/5 * * * * /opt/poshard/gufo-gestiune-full/ops/hetzner/health-check.sh >> /var/log/gufo-health.log 2>&1

# Weekly restore test every Sunday at 03:30 on latest backup
30 3 * * 0 LATEST=$(/usr/bin/find /opt/poshard/backups/gufo/daily -type f -name "gufo-db-*.dump" | /usr/bin/sort | /usr/bin/tail -n 1); [ -n "$LATEST" ] && /opt/poshard/gufo-gestiune-full/ops/hetzner/test-restore-db.sh "$LATEST" >> /var/log/gufo-restore-test.log 2>&1
